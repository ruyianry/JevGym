# Copy to .env and fill in as needed. All values are optional for offline/fixture runs.

# --- Kalshi (data source) ---------------------------------------------------
# Public reads need NO auth. Set the key pair only to use a higher-rate authenticated tier.
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# --- FRED (macro-indicator evidence) ---------------------------------------
# Free API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_BASE=https://api.stlouisfed.org/fred
FRED_API_KEY=

# --- Official Jev (TypeSafe) : reference decision model ---------------------
TYPESAFE_API_BASE=https://api.typesafe.ai
TYPESAFE_API_KEY=

# --- Open Jev-wire servers --------------------------------------------------
# Von / Decider(server) / razorback16-OpenJev all speak POST {base}/v1/systemone.
# Point the eval at a running server via --base-url on the CLI, or set defaults here.
# VON_BASE=http://127.0.0.1:8000
# DECIDER_BASE=http://127.0.0.1:8001
# OPENJEV_BASE=http://127.0.0.1:8002

# --- LLM backbones (the "generic LLM" / agentic forecaster) -----------------
# Agents: llm / llm_agent (Claude), gpt / gpt_agent (ChatGPT), qwen / qwen_agent,
# gemini / gemini_agent. OpenAI/Qwen/Gemini all use the OpenAI-compatible wire.

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ChatGPT (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=          # only to override the default api.openai.com/v1

# Qwen (open source) — DashScope, or a local vLLM/Ollama server
QWEN_API_KEY=              # DashScope key; leave blank for a local server (uses "EMPTY")
QWEN_MODEL=qwen2.5-72b-instruct
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# e.g. local: QWEN_BASE_URL=http://127.0.0.1:8000/v1   (vLLM)  or  http://localhost:11434/v1 (Ollama)

# Gemini (Google) — via the OpenAI-compatibility endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Time-bounded search (agentic evidence gathering) -----------------------
# Every search/fetch is bounded to the snapshot timestamp (no future leakage).
#   wayback : Internet Archive fetch, leakage-safe, NO key needed (default)
#   serp    : dated web search for discovery (needs SEARCH_API_KEY); fetch via Wayback
#   mock    : offline canned results
SEARCH_PROVIDER=wayback
SEARCH_API_KEY=

# --- HuggingFace publishing -------------------------------------------------
# Do NOT hardcode the owner; the repo id is fully configurable.
HF_REPO_ID=
HF_TOKEN=

# --- Misc -------------------------------------------------------------------
# Override the local data directory (default: ./data)
JEVARENA_DATA_DIR=data
