# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets — the real .env and any local variants/backups (but keep the .env.example template).
.env
.env.*
!.env.example

# Confidential internal notes (roadmap, honest caveats, deploy guide) — never publish.
CONFIDENTIAL.md
*.private.md

# Local data: raw caches + derived artifacts are NOT committed (see README data policy).
# Raw third-party API payloads especially must never be committed or published.
# NOTE: anchored to the repo root with a leading slash so it does NOT match the source
# package src/jevgym/data/ (which is code and must ship).
/data/
!/data/.gitkeep

# Local agent/IDE config (contains machine-specific absolute paths; not for the public repo).
.claude/

.DS_Store
